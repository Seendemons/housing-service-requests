# Для локального HTTP — false; для HTTPS установите true.
SESSION_COOKIE_SECURE=false
# Выберите свои непустые пароли перед созданием демо-пользователей.
DEMO_RESIDENT_PASSWORD=
DEMO_DISPATCHER_PASSWORD=
