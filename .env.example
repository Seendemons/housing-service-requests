APP_NAME="Заявки в жилищную службу"
APP_DEBUG=false

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=housing_requests
POSTGRES_USER=housing_user
# Вымышленный пример: обязательно замените пароль перед запуском.
POSTGRES_PASSWORD=replace_with_your_own_password
